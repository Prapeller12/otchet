{
  "$schema": "../schemas/report-definition/matrix-definition.schema.json",
  "schema_version": "1.0.0",
  "definition_id": "wrk-head-site",
  "definition_version": "0.1.0",
  "status": "WORKING_REFERENCE",
  "report_type": "HEAD_SITE",
  "production_use": false,
  "identity_policy": {
    "kind": "SYNTHETIC_OPAQUE",
    "real_business_keys_included": false
  },
  "source_basis": [
    "AGENTS.md 4.2, 5.2 and 5.4",
    "DEV v0.5 9.4, 9.5.2 and 9.6",
    "docs/ui-contracts/head-site-working-reference.md"
  ],
  "matrix_rules": {
    "dates_or_periods_horizontal": true,
    "groups_vertical": true,
    "direct_matrix_input": true,
    "required_rows_visible": true,
    "blank_and_zero_distinct": true,
    "calculated_values_read_only": true
  },
  "layout": {
    "freeze": {
      "top_date_header": true,
      "left_identifiers": true
    },
    "identifier_columns": [
      {
        "column_id": "wrk-head-party",
        "label": "Изготовитель/поставщик",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-object",
        "label": "Сборочный комплект/готовое изделие",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-indicator",
        "label": "Показатель",
        "binding": { "status": "OPEN" }
      }
    ],
    "horizontal_axis": {
      "axis_id": "wrk-head-dates",
      "kind": "RUNTIME_CALENDAR_DATE",
      "generation": {
        "mode": "RUNTIME",
        "period_unit_status": "CALENDAR_DATE"
      }
    },
    "summary_columns": [
      {
        "column_id": "wrk-head-total-received",
        "label": "Всего получено",
        "value_role": "CALCULATED",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-total-used",
        "label": "Всего использовано",
        "value_role": "CALCULATED",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-product-balance",
        "label": "Остаток изделий",
        "value_role": "CALCULATED",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-month-total",
        "label": "Итого за месяц",
        "value_role": "CALCULATED",
        "binding": { "status": "OPEN" }
      },
      {
        "column_id": "wrk-head-cumulative-total",
        "label": "Накопительный итог",
        "value_role": "CALCULATED",
        "binding": { "status": "OPEN" }
      }
    ],
    "row_groups": [
      {
        "group_id": "wrk-head-assembly-set-group",
        "group_kind": "ASSEMBLY_SET",
        "label": "Сборочный комплект 1",
        "repeatable": true,
        "rows": [
          {
            "row_id": "wrk-head-assembly-plan",
            "label": "План выпуска по кодам",
            "value_role": "WORKING_INPUT",
            "binding": { "status": "OPEN" },
            "code_breakdown": true
          },
          {
            "row_id": "wrk-head-assembly-fact",
            "label": "Факт выпуска по кодам",
            "value_role": "WORKING_INPUT",
            "binding": { "status": "OPEN" },
            "code_breakdown": true
          }
        ]
      },
      {
        "group_id": "wrk-head-finished-product-group",
        "group_kind": "FINISHED_PRODUCT",
        "label": "Готовое изделие 1",
        "repeatable": true,
        "rows": [
          {
            "row_id": "wrk-head-product-plan",
            "label": "План выпуска по кодам",
            "value_role": "WORKING_INPUT",
            "binding": { "status": "OPEN" },
            "code_breakdown": true
          },
          {
            "row_id": "wrk-head-product-fact",
            "label": "Факт выпуска по кодам",
            "value_role": "WORKING_INPUT",
            "binding": { "status": "OPEN" },
            "code_breakdown": true
          }
        ]
      }
    ]
  },
  "open_items": [
    "Устойчивые ключи изготовителей, комплектов, изделий, кодов и модификаций",
    "Точная нумерация и количество строк и календарных колонок",
    "Карта ручного ввода, импорта и backend-расчётов",
    "Семантика каждого месячного и накопительного итога",
    "Правила защиты периода, экспорта и печати"
  ]
}
