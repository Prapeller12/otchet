{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reporting-system:schema:report-draft-request:1",
  "title": "Authorized atomic draft for one report month",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "organization_id",
    "year",
    "confirmation",
    "base_revision",
    "idempotency_key",
    "changes",
    "authorization"
  ],
  "properties": {
    "report_type": {
      "$ref": "#/$defs/ReportType"
    },
    "organization_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "week_start": {
          "$ref": "#/$defs/IsoDate"
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "coordinate",
          "value"
        ],
        "properties": {
          "coordinate": {
            "$ref": "#/$defs/ReportCellCoordinate"
          },
          "value": {
            "$ref": "#/$defs/ReportCellValue"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_id",
        "pin"
      ],
      "properties": {
        "signer_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "pin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "widths": {
          "type": "object",
          "maxProperties": 400,
          "additionalProperties": {
            "type": "integer",
            "minimum": 48,
            "maximum": 600
          }
        },
        "plans": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "patternProperties": {
            "^[0-9]{4}-(0[1-9]|1[0-2])$": {
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false,
          "description": "Exactly the selected confirmation month; empty string means data not provided, zero is explicit."
        },
        "actuals": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "patternProperties": {
            "^[0-9]{4}-(0[1-9]|1[0-2])$": {
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false,
          "description": "Exactly the selected confirmation month; empty string means data not provided, zero is explicit."
        },
        "production_code_plans": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "patternProperties": {
              "^[0-9]{4}-(0[1-9]|1[0-2])$": {
                "type": "string",
                "maxLength": 100
              }
            },
            "additionalProperties": false,
            "description": "Exactly the selected confirmation month; empty string means data not provided, zero is explicit."
          }
        },
        "production_code_actuals": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "patternProperties": {
              "^[0-9]{4}-(0[1-9]|1[0-2])$": {
                "type": "string",
                "maxLength": 100
              }
            },
            "additionalProperties": false,
            "description": "Exactly the selected confirmation month; empty string means data not provided, zero is explicit."
          }
        },
        "confirm_production_totals": {
          "type": "boolean"
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_designation": {
              "type": "string",
              "maxLength": 200
            },
            "product_name": {
              "type": "string",
              "maxLength": 200
            },
            "factory_name": {
              "type": "string",
              "maxLength": 200
            },
            "product_image": {
              "type": "string",
              "description": "Validated embedded image using existing report header policy."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Opaque non-empty identifier. Consumers must not infer its storage type or parse business meaning from it."
    },
    "ContractCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Externally governed uppercase contract code. The schema deliberately does not invent or alias business codes."
    },
    "ReportType": {
      "type": "string",
      "enum": [
        "DAILY_MOVEMENT",
        "HEAD_SITE",
        "SUBSIDIARY"
      ],
      "description": "Canonical report type approved in DEV documentation v0.5, section 9.8."
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO 8601 calendar date in YYYY-MM-DD form."
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Exact base-10 value serialized as a string; JSON numbers and scientific notation are not accepted."
    },
    "ReportCellCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_type",
        "organization_id"
      ],
      "properties": {
        "report_type": {
          "$ref": "#/$defs/ReportType"
        },
        "organization_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "product_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "component_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "metric_code": {
          "$ref": "#/$defs/ContractCode"
        },
        "operation_type": {
          "$ref": "#/$defs/ContractCode"
        },
        "operation_date": {
          "$ref": "#/$defs/IsoDate"
        },
        "period_start": {
          "$ref": "#/$defs/IsoDate"
        },
        "bom_version_id": {
          "$ref": "#/$defs/OpaqueId"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "product_id"
              ],
              "not": {
                "required": [
                  "component_id"
                ]
              }
            },
            {
              "required": [
                "component_id"
              ],
              "not": {
                "required": [
                  "product_id"
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "metric_code"
              ],
              "not": {
                "required": [
                  "operation_type"
                ]
              }
            },
            {
              "required": [
                "operation_type"
              ],
              "not": {
                "required": [
                  "metric_code"
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "operation_date"
              ],
              "not": {
                "required": [
                  "period_start"
                ]
              }
            },
            {
              "required": [
                "period_start"
              ],
              "not": {
                "required": [
                  "operation_date"
                ]
              }
            }
          ]
        }
      ]
    },
    "DataNotProvidedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "DATA_NOT_PROVIDED"
        }
      }
    },
    "QuantityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "quantity"
      ],
      "properties": {
        "kind": {
          "const": "QUANTITY"
        },
        "quantity": {
          "$ref": "#/$defs/DecimalString"
        }
      }
    },
    "ReportCellValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/DataNotProvidedValue"
        },
        {
          "$ref": "#/$defs/QuantityValue"
        }
      ]
    }
  }
}
